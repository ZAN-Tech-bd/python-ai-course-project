{
  "manifest_version": 3,
  "name": "Ice Cream Catch - ZAN Tech",
  "short_name": "Ice Cream Catch",
  "version": "1.0.0",
  "description": "Catch falling ice cream on a cone on your head! A webcam party game for kids - up to 6 friends play at once. By ZAN Tech.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Play Ice Cream Catch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
