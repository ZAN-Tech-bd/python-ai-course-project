{
  "manifest_version": 3,
  "name": "Food Slice - ZAN Tech",
  "short_name": "Food Slice",
  "version": "1.0.0",
  "description": "Swipe your finger in front of the webcam to cut flying fruit! A kid-friendly hand-tracking game by ZAN Tech.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Play Food Slice",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
